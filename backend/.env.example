# Server
PORT=3000
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Firebase Realtime Database
FIREBASE_DATABASE_URL=https://modytech-850c2-default-rtdb.firebaseio.com
# Put the complete Firebase service-account JSON on one line here.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
# Alternative: set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON file path.

# Paymob Egypt
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=sk_test_REPLACE_ME
PAYMOB_PUBLIC_KEY=pk_test_REPLACE_ME
PAYMOB_HMAC_SECRET=REPLACE_ME
# Comma-separated Paymob Integration IDs. Use IDs that match the same test/live mode as the keys.
PAYMOB_INTEGRATION_IDS=123456

# Telegram
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_CHAT_ID=REPLACE_ME

# WhatsApp Cloud API
# Use the phone number ID from Meta WhatsApp Manager, not the visible phone number.
WHATSAPP_GRAPH_VERSION=v23.0
META_ACCESS_TOKEN=REPLACE_ME
META_APP_SECRET=REPLACE_ME
WHATSAPP_PHONE_NUMBER_ID=REPLACE_ME
WHATSAPP_ORDER_CONFIRM_TEMPLATE=REPLACE_ME
WHATSAPP_TEMPLATE_LANGUAGE=ar
WHATSAPP_VERIFY_TOKEN=REPLACE_ME_WITH_A_RANDOM_STRING
# Public HTTPS base URL where Meta can reach this backend.
PUBLIC_WEBHOOK_BASE=https://api.example.com
# Keep false in production. Only use true for a local, unsigned test request.
WHATSAPP_SKIP_SIGNATURE=false
